{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage/contract/edit-spec.schema.json",
  "title": "OpenMontage edit-spec (skeleton, not finalized)",
  "description": "编辑规格契约骨架。未定稿、未验收；字段/取值/门禁须由制片统筹或独立质检最终确定。不得以本骨架冒充已验收的正式契约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "inputs", "operations", "constraints", "expected", "cost_gate", "provenance"],
  "properties": {
    "id": { "type": "string", "description": "规格唯一标识" },
    "intent": { "type": "string", "description": "编辑意图描述" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "license"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "description": "素材类型：video/audio/image/text/script 等" },
          "license": { "type": "string", "description": "来源/许可：self-authored / authorized / mock 等" }
        }
      }
    },
    "operations": {
      "type": "array",
      "description": "有序编辑/合成操作",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["op"],
        "properties": { "op": { "type": "string" } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "description": "硬约束：时长/分辨率/帧率/安全区/成本上限等"
    },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "description": "期望输出：格式/时长区间/质量门/可复现参数"
    },
    "cost_gate": {
      "type": "object",
      "additionalProperties": true,
      "description": "成本门禁：是否允许付费服务及上限；默认零付费本地"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "来源/许可/生成工具/已核实成本；本地 mock/离线替身须标注"
    }
  }
}
